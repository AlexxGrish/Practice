<Window
    x:Class="Pracrice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Title="ООО «РОСПИВ» — информационная система"
    Width="1280"
    Height="760"
    MinWidth="1100"
    MinHeight="680"
    Background="{StaticResource MainBg}"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    mc:Ignorable="d">

    <Window.Resources>

        <Style x:Key="NavigationTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="NavigationItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GroupName" Value="MainNavigation" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="14,0"
                                CornerRadius="8"
                                Margin="8,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" />
                                <TextBlock x:Name="BtnText"
                                           Grid.Column="1"
                                           Text="{TemplateBinding AutomationProperties.Name}"
                                           Style="{StaticResource NavigationTextStyle}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                                <Setter TargetName="BtnText" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="14,0"
                                CornerRadius="8"
                                Margin="8,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" />
                                <TextBlock x:Name="BtnText"
                                           Grid.Column="1"
                                           Text="{TemplateBinding AutomationProperties.Name}"
                                           Style="{StaticResource NavigationTextStyle}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FA08B" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="22,16,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1C2427" BorderBrush="#33443D" BorderThickness="0,0,0,1">
            <Menu VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="Файл">
                    <MenuItem Header="Сменить пользователя" Click="LogoutMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Выход" Click="ExitMenuItem_Click" />
                </MenuItem>

                <MenuItem x:Name="ModulesMenu" Header="Модули" IsEnabled="False">
                    <MenuItem Header="План выпуска продукции" Tag="OptPlan" Click="ModuleMenu_Click" />
                    <MenuItem Header="План перевозок" Tag="OptimalRoute" Click="ModuleMenu_Click" />
                    <MenuItem Header="Обновление оборудования" Tag="OptimalEq" Click="ModuleMenu_Click" />
                    <MenuItem Header="Планирование касс" Tag="OptTick" Click="ModuleMenu_Click" />
                    <MenuItem Header="Распределение инвестиций" Tag="Invest" Click="ModuleMenu_Click" />
                    <Separator />
                    <MenuItem Header="Товары и изображения" Tag="ProductsNav" Click="ModuleMenu_Click" />
                    <MenuItem Header="Отчёты" Tag="Reports" Click="ModuleMenu_Click" />
                </MenuItem>

                <MenuItem x:Name="ReferencesMenu" Header="Справочники" IsEnabled="False">
                    <MenuItem Header="Все справочники" Click="OpenReferences_Click" />
                    <Separator />
                    <MenuItem Header="Ресурсы" Tag="Resources" Click="OpenReferenceSection_Click" />
                    <MenuItem Header="Склады" Tag="Warehouses" Click="OpenReferenceSection_Click" />
                    <MenuItem Header="Магазины" Tag="Stores" Click="OpenReferenceSection_Click" />
                    <MenuItem Header="Рецептуры" Tag="ProductRecipes" Click="OpenReferenceSection_Click" />
                    <MenuItem Header="Расстояния" Tag="Distances" Click="OpenReferenceSection_Click" />
                    <MenuItem Header="Складские остатки" Tag="Stocks" Click="OpenReferenceSection_Click" />
                    <MenuItem Header="Инвестиционные компании" Tag="InvestmentCompanies" Click="OpenReferenceSection_Click" />
                    <MenuItem Header="Инвестиционные ставки" Tag="InvestmentRates" Click="OpenReferenceSection_Click" />
                </MenuItem>

                <MenuItem x:Name="ReportsMenu" Header="Отчёты" IsEnabled="False">
                    <MenuItem Header="Центр отчётов" Tag="Reports" Click="ModuleMenu_Click" />
                    <Separator />
                    <MenuItem Header="Товары и изображения" Tag="Products" Click="GenerateReportMenu_Click" />
                    <MenuItem Header="Складские остатки" Tag="Stocks" Click="GenerateReportMenu_Click" />
                    <MenuItem Header="Рецептуры" Tag="Recipes" Click="GenerateReportMenu_Click" />
                    <MenuItem Header="Инвестиционные ставки" Tag="InvestmentRates" Click="GenerateReportMenu_Click" />
                    <MenuItem x:Name="UsersReportMenuItem" Header="Пользователи системы" Tag="Users"
                              Click="GenerateReportMenu_Click" Visibility="Collapsed" />
                </MenuItem>

                <MenuItem x:Name="AdminMenu" Header="Администрирование" Visibility="Collapsed">
                    <MenuItem Header="Пользователи" Tag="AdminPanel" Click="ModuleMenu_Click" />
                    <MenuItem Header="Добавить пользователя" Click="BtnAddUser_Click" />
                    <Separator />
                    <MenuItem Header="Изменить свою учётную запись" Click="MenuItemChangeOwnPassword_Click" />
                </MenuItem>

                <MenuItem Header="Справка">
                    <MenuItem Header="О программе" Click="AboutMenuItem_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,16,18,0" VerticalAlignment="Top">
                        <Image Source="/Assets/logo.png"
                               Height="58"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               ToolTip="ООО «РОСПИВ» — пивоваренная компания" />
                        <TextBlock Text="Информационная система «РОСПИВ»"
                                   Foreground="#C8D6C8"
                                   FontSize="10"
                                   Margin="2,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavigationPanel">
                            <RadioButton x:Name="MenuLogin"
                                         AutomationProperties.Name="Вход в систему"
                                         Style="{StaticResource NavigationItemStyle}"
                                         IsChecked="True"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/login.svg" Width="18" Height="18" />
                            </RadioButton>

                            <TextBlock Text="МОДУЛИ" Style="{StaticResource NavSectionHeader}" />
                            <RadioButton x:Name="OptPlan" AutomationProperties.Name="План выпуска продукции"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/plan.svg" Width="18" Height="18" />
                            </RadioButton>
                            <RadioButton x:Name="OptimalRoute" AutomationProperties.Name="План перевозок"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/route.svg" Width="18" Height="18" />
                            </RadioButton>
                            <RadioButton x:Name="OptimalEq" AutomationProperties.Name="Обновление оборудования"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/equipment.svg" Width="18" Height="18" />
                            </RadioButton>
                            <RadioButton x:Name="OptTick" AutomationProperties.Name="Планирование касс"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/cash.svg" Width="18" Height="18" />
                            </RadioButton>
                            <RadioButton x:Name="Invest" AutomationProperties.Name="Распределение инвестиций"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/invest.svg" Width="18" Height="18" />
                            </RadioButton>

                            <TextBlock Text="ДАННЫЕ" Style="{StaticResource NavSectionHeader}" />
                            <RadioButton x:Name="ProductsNav" AutomationProperties.Name="Товары и изображения"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/products.svg" Width="18" Height="18" />
                            </RadioButton>
                            <RadioButton x:Name="Reports" AutomationProperties.Name="Отчёты"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/report.svg" Width="18" Height="18" />
                            </RadioButton>
                            <Button x:Name="ReferencesNav" AutomationProperties.Name="Справочники"
                                    Style="{StaticResource NavigationButtonStyle}" IsEnabled="False"
                                    Click="OpenReferences_Click">
                                <svgc:SvgViewbox Source="/Icons/catalog.svg" Width="18" Height="18" />
                            </Button>

                            <RadioButton x:Name="AdminPanel" AutomationProperties.Name="Администрирование"
                                         Style="{StaticResource NavigationItemStyle}" IsEnabled="False"
                                         Visibility="Collapsed" Checked="NavigationItem_Checked">
                                <svgc:SvgViewbox Source="/Icons/admin.svg" Width="18" Height="18" />
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource SidebarDeep}" Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="FIO"
                                       Text="Не авторизован"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Текущий пользователь" />
                            <TextBlock x:Name="humRole"
                                       Text="Вход не выполнен"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="LogoutButton"
                                    Content="Выйти из учётной записи"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="32"
                                    FontSize="11"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed"
                                    Click="LogoutButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource MainBg}" Padding="26">
                <Grid>

                    <Grid x:Name="LoginView"
                          Visibility="{Binding IsChecked, ElementName=MenuLogin, Converter={StaticResource BoolToVis}}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="470">
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="38,30"
                                BorderBrush="#3E6B58" BorderThickness="1">
                            <StackPanel>
                                <Image Source="/Assets/logo.png" Height="84" Stretch="Uniform"
       HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Image.Effect>
                                        <DropShadowEffect ShadowDepth="10"
                                                          BlurRadius="30"
                                                          Direction="-40"
                                                          Opacity="0.5"
                                                          />
                                    </Image.Effect>
                                </Image>

                                <TextBlock Text="Вход в систему"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="ООО «РОСПИВ» · информационная система"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,24" />

                                <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LoginText"
                                         Height="42"
                                         Margin="0,0,0,16"
                                         ToolTip="Введите логин учётной записи, выданный администратором"
                                         KeyDown="LoginField_KeyDown" />

                                <TextBlock Text="Пароль *" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="PassText"
                                             Height="42"
                                             Margin="0,0,0,24"
                                             ToolTip="Введите пароль учётной записи. Пароль хранится в базе данных в виде хеша"
                                             KeyDown="LoginField_KeyDown" />

                                <Button x:Name="BtnLogin"
                                        Content="Войти"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="44"
                                        Click="BtnLogin_Click"
                                        ToolTip="Проверить логин и пароль и войти в систему" />

                             
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="OptPlanv" Visibility="{Binding IsChecked, ElementName=OptPlan, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="План выпуска продукции" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Оптимальные объёмы выпуска с максимальной прибылью при лимитах ресурсов"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnPlanExport" Content="Экспорт" Width="100" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0" Click="BtnPlanExport_Click"
                                        ToolTip="Сформировать HTML-отчёт по плану выпуска" />
                                <Button Content="Рассчитать план" Width="150" Style="{StaticResource PrimaryButton}"
                                        Click="BtnPlanCalc_Click"
                                        ToolTip="Рассчитать оптимальный план выпуска по данным справочников" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBg}"
                                    Margin="0,0,10,10" CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Нормы расхода и прибыль (на 1 шт.)"
                                               Style="{StaticResource CardTitle}" />
                                    <DataGrid Grid.Row="1" Name="ProductsPlanGrid" IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Вкл." Width="42">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  ToolTip="Включить товар в расчёт" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Продукция" Width="*" Binding="{Binding Product}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Сырьё, кг" Width="75" Binding="{Binding Raw, StringFormat=F2}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Вода, л" Width="80" Binding="{Binding Fill, StringFormat=F2}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Упаковка, шт." Width="95" Binding="{Binding Pack, StringFormat=F2}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Прибыль, ₽" Width="95" Binding="{Binding Profit, StringFormat=F0}" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBg}"
                                    Margin="10,0,0,10" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Ограничения ресурсов" Style="{StaticResource CardTitle}" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="Сырьё, кг" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="RawLimitText" Height="38" Text="6 400"
                                                     ToolTip="Максимальный запас сырья на планируемый период, кг" />
                                        </StackPanel>
                                        <StackPanel Margin="5,0,0,0">
                                            <TextBlock Text="Вода, л" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="FillLimitText" Height="38" Text="4 800"
                                                     ToolTip="Максимальный расход воды на планируемый период, литров" />
                                        </StackPanel>
                                        <StackPanel Margin="0,10,5,0">
                                            <TextBlock Text="Упаковка, шт." Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="PackLimitText" Height="38" Text="3 600"
                                                     ToolTip="Максимальное количество упаковочных комплектов на период, штук" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="{StaticResource CardBg}" Margin="0,10,0,0"
                                    CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Максимальная прибыль" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="PlanProfitText" Text="—" Foreground="White"
                                                   FontSize="30" FontWeight="Bold" />
                                        <TextBlock x:Name="PlanUsageText" Text="Расчёт не выполнен"
                                                   Foreground="{StaticResource AccentGreen}" FontSize="12"
                                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Margin="20,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Оптимальный выпуск"
                                                   Foreground="{StaticResource AccentGreen}" FontSize="14"
                                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <DataGrid Grid.Row="1" Name="PlanResultGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Продукция" Width="*" Binding="{Binding Product}" />
                                                <DataGridTextColumn Header="Выпуск, шт." Width="110" Binding="{Binding Volume}" />
                                                <DataGridTextColumn Header="Прибыль, ₽" Width="110" Binding="{Binding Profit}" />
                                                <DataGridTextColumn Header="Доля" Width="80" Binding="{Binding Share}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="OptimalRoutev" Visibility="{Binding IsChecked, ElementName=OptimalRoute, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="План перевозок" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Оптимальное распределение продукции от складов к магазинам"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnRouteExport" Content="Экспорт" Width="100" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0" Click="BtnRouteExport_Click"
                                        ToolTip="Сформировать HTML-отчёт по плану перевозок" />
                                <Button Content="Рассчитать план" Width="150" Style="{StaticResource PrimaryButton}"
                                        Click="BtnRouteCalc_Click" ToolTip="Рассчитать оптимальный план перевозок" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.2*" />
                                <RowDefinition Height="0.8*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBg}"
                                    Margin="0,0,10,10" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Тарифы и запасы (₽ / ед.)" Style="{StaticResource CardTitle}"
                                               Margin="0,0,0,6" />
                                    <DataGrid Grid.Row="1" Name="TariffsDataGrid" IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Вкл." Width="42">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  ToolTip="Включить склад в расчёт" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Склад" Width="*" Binding="{Binding Warehouse}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Магазин 1" Width="110" Binding="{Binding Shop1}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Магазин 2" Width="110" Binding="{Binding Shop2}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Магазин 3" Width="110" Binding="{Binding Shop3}" IsReadOnly="True" />
