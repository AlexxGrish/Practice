<Window
    x:Class="Pracrice.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Title="Main Screen"
    Width="1280"
    Height="720"
    MinWidth="640"
    MinHeight="480"
    Background="#273338"
    FontFamily="Inter, Segoe UI"
    ResizeMode="CanResize"
    SizeToContent="Manual"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="SidebarBrush" Color="#2B5748" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#316552" />
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#376E5A" />
        <SolidColorBrush x:Key="DividerBrush" Color="#322F35" />

        <Style x:Key="NavigationItemStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="54" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#92AC72" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="12,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <Style x:Key="MenuIconStyle" TargetType="{x:Type svgc:SvgViewbox}">
            <Setter Property="Width" Value="29" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Background="#273338">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="sidebarmenu">
</StackPanel>
        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="Black"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                    <Canvas>
                        <TextBlock
                            Canvas.Left="16"
                            Canvas.Top="4"
                            Foreground="White"
                            FontFamily="Inter, Segoe UI"
                            FontSize="12"
                            FontWeight="Normal"
                            Text="NOTLOGIINED" 
                            Name="FIO"/>
                        <TextBlock
                            Canvas.Left="16"
                            Canvas.Top="19"
                            Foreground="White"
                            FontFamily="Inter, Segoe UI"
                            FontSize="10"
                            FontWeight="Normal"
                            Text="NOTLOGIINED" 
                            Name="humRole"/>
                    </Canvas>
                </Border>

                <RadioButton
                     x:Name="MenuLogin"
                    Grid.Row="1"
                    AutomationProperties.Name="Вход"
                    GroupName="MainNavigation"
                    Style="{StaticResource NavigationItemStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource MenuTextStyle}"
                            Text="Вход" />
                        <svgc:SvgViewbox
                            Grid.Column="1"
                            Source="/FigmaLayout.Wpf;component/Assets/f2052.svg"
                            Style="{StaticResource MenuIconStyle}" />
                    </Grid>
                </RadioButton>

                <RadioButton
                    Grid.Row="2"
                    x:Name="OptPlan"
                    AutomationProperties.Name="Определение оптимального плана выпуска продукции"
                    GroupName="MainNavigation"
                    Style="{StaticResource NavigationItemStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource MenuTextStyle}"
                            Text="Определение оптимального&#x0A;плана выпуска продукции" />
                        <svgc:SvgViewbox
                            Grid.Column="1"
                            Source="/FigmaLayout.Wpf;component/Assets/71828.svg"
                            Style="{StaticResource MenuIconStyle}" />
                    </Grid>
                </RadioButton>

                <RadioButton
                    Grid.Row="3"
                    x:Name="OptimalRoute"
                    AutomationProperties.Name="Составление оптимального плана перевозок продукции от складов к магазинам"
                    GroupName="MainNavigation"
                    Style="{StaticResource NavigationItemStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource MenuTextStyle}"
                            Text="Составление оптимального&#x0A;плана перевозок продукции&#x0A;от складов к магазинам" />
                        <svgc:SvgViewbox
                            Grid.Column="1"
                            Source="/FigmaLayout.Wpf;component/Assets/0fafe.svg"
                            Style="{StaticResource MenuIconStyle}" />
                    </Grid>
                </RadioButton>

                <RadioButton
                    x:Name="OptimalEq"
                    Grid.Row="4"
                    AutomationProperties.Name="Определение стратегии обновления оборудования на производстве"
                    GroupName="MainNavigation"
                    Style="{StaticResource NavigationItemStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource MenuTextStyle}"
                            Text="Определение стратегии&#x0A;обновления оборудования&#x0A;на производстве" />
                        <svgc:SvgViewbox
                            Grid.Column="1"
                            Source="/FigmaLayout.Wpf;component/Assets/226eb.svg"
                            Style="{StaticResource MenuIconStyle}" />
                    </Grid>
                </RadioButton>

                <RadioButton
                    Grid.Row="5"
                    x:Name="OptTick"
                    AutomationProperties.Name="Определение оптимального количества касс в магазинах"
                    GroupName="MainNavigation"
                    Style="{StaticResource NavigationItemStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource MenuTextStyle}"
                            Text="Определение оптимального&#x0A;количества касс в магазинах" />
                        <svgc:SvgViewbox
                            Grid.Column="1"
                            Source="/FigmaLayout.Wpf;component/Assets/03a0f.svg"
                            Style="{StaticResource MenuIconStyle}" />
                    </Grid>
                </RadioButton>

                <RadioButton
                    x:Name="Invest"
                    Grid.Row="6"
                    AutomationProperties.Name="Распределение инвестиций"
                    GroupName="MainNavigation"
                    Style="{StaticResource NavigationItemStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource MenuTextStyle}"
                            Text="Распределение&#x0A;инвестиций" />
                        <svgc:SvgViewbox
                            Grid.Column="1"
                            Source="/FigmaLayout.Wpf;component/Assets/61cf9.svg"
                            Style="{StaticResource MenuIconStyle}" />
                    </Grid>
                </RadioButton>


            </Grid>
        </Border>
        <Canvas Grid.Column="1" x:Name="MainCanvas">

            <!-- ========================================== -->
            <!-- 1. ЭКРАН: АВТОРИЗАЦИЯ                      -->
            <!-- ========================================== -->
            <!-- Задаем положение на Canvas через прикрепленные свойства -->
            <Grid Canvas.Left="200" Canvas.Top="150" Width="500" Height="350"
                  Visibility="{Binding IsChecked, ElementName=MenuLogin, Converter={StaticResource BoolToVis}}">

                <Border Background="#1C3830" CornerRadius="8" Padding="30">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Авторизация" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBox x:Name="LoginText" Margin="0,10" Height="40" VerticalContentAlignment="Center" Tag="Логин"/>
                        <PasswordBox x:Name="PassText" Margin="0,10" Height="40" VerticalContentAlignment="Center"/>
                        <Button Content="Войти" Height="45" Margin="0,20,0,0" Background="#9EB291" Click="BtnLogin_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 2. ЭКРАН: ТАБЛИЦА ПРОДУКТОВ И РАСЧЕТЫ      -->
            <!-- ========================================== -->
            <Grid Canvas.Left="50" Canvas.Top="40" Width="900" Height="580"
                  Visibility="{Binding IsChecked, ElementName=OptPlan, Converter={StaticResource BoolToVis}}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Определение оптимального плана выпуска" Foreground="White" FontSize="24" Margin="0,0,0,20"/>

                <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="10">

                    <!-- Карточка 1: Таблица продуктов -->
                    <Border Background="#1D3E35" Margin="10" CornerRadius="4" Padding="20">
                        <!-- Используем Grid, чтобы DataGrid занимал всё оставшееся пространство карточки -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Таблица продуктов" Foreground="#9EB291" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <DataGrid Grid.Row="1" 
                      Background="Transparent" 
                      BorderThickness="0" 
                      RowBackground="#264D42" 
                      AlternatingRowBackground="#1D3E35" 
                      Foreground="White"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      AutoGenerateColumns="False"
                                      Name="Products">
                                <DataGrid.Resources>
                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                        <!-- Цвет фона заголовка (темно-зеленый, под цвет карточки) -->
                                        <Setter Property="Background" Value="#153029" />
                                        <!-- Цвет текста заголовка -->
                                        <Setter Property="Foreground" Value="#9EB291" />
                                        <!-- Шрифт и отступы внутри заголовка -->
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="10,6,10,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <!-- Убираем стандартную тонкую рамку вокруг заголовков -->
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Продукция" Width="*" Binding="{Binding Name}"/>
                                    <DataGridTextColumn Header="Цена" Width="80" Binding="{Binding Price}"/>
                                    <DataGridTextColumn Header="Спрос" Width="80" Binding="{Binding Demand}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Карточка 2: Таблица ресурсов -->
                    <Border Background="#1D3E35" Margin="10" CornerRadius="4" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Таблица ресурсов" Foreground="#9EB291" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <DataGrid Grid.Row="1" 
                      Background="Transparent" 
                      BorderThickness="0" 
                      RowBackground="#264D42" 
                      AlternatingRowBackground="#1D3E35" 
                      Foreground="White"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      AutoGenerateColumns="False">
                                <DataGrid.Resources>
                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                        <!-- Цвет фона заголовка (темно-зеленый, под цвет карточки) -->
                                        <Setter Property="Background" Value="#153029" />
                                        <!-- Цвет текста заголовка -->
                                        <Setter Property="Foreground" Value="#9EB291" />
                                        <!-- Шрифт и отступы внутри заголовка -->
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="10,6,10,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <!-- Убираем стандартную тонкую рамку вокруг заголовков -->
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ресурс" Width="*" Binding="{Binding ResourceName}"/>
                                    <DataGridTextColumn Header="Доступно" Width="100" Binding="{Binding Available}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Карточка 3: Максимальная прибыль (Вывод результатов) -->
                    <Border Background="#1D3E35" Margin="10" CornerRadius="4" Padding="20">
                        <!-- Для простых текстовых блоков достаточно StackPanel -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Максимальная прибыль" Foreground="#9EB291" FontSize="14" Margin="0,0,0,5"/>
                            <TextBlock Text="0.00 ₽" Foreground="White" FontSize="28" FontWeight="Bold"/>

                            <TextBlock Text="Общие затраты" Foreground="#D1DDD6" FontSize="14" Margin="0,15,0,5"/>
                            <TextBlock Text="0.00 ₽" Foreground="White" FontSize="20"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка 4: Рекомендованный объем -->
                    <Border Background="#1D3E35" Margin="10" CornerRadius="4" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Рекомендованный объем" Foreground="#9EB291" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <DataGrid Grid.Row="1" 
                      Background="Transparent" 
                      BorderThickness="0" 
                      RowBackground="#264D42" 
                      Foreground="White"
                      HeadersVisibility="Column"
                      IsReadOnly="True">
                                <DataGrid.Resources>
                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                        <!-- Цвет фона заголовка (темно-зеленый, под цвет карточки) -->
                                        <Setter Property="Background" Value="#153029" />
                                        <!-- Цвет текста заголовка -->
                                        <Setter Property="Foreground" Value="#9EB291" />
                                        <!-- Шрифт и отступы внутри заголовка -->
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="10,6,10,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <!-- Убираем стандартную тонкую рамку вокруг заголовков -->
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </DataGrid.Resources>
                                <!-- Вывод результатов расчета -->
                            </DataGrid>
                        </Grid>
                    </Border>

                </UniformGrid>

            </Grid>

        </Canvas>
    </Grid>
</Window>
