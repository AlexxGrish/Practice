                                        <TextBlock Text="Каталог продукции" Style="{StaticResource CardTitle}" />
                                        <TextBlock x:Name="ProductsCountText" Text="0 позиций"
                                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataGrid Grid.Row="1" x:Name="ProductsGrid"
                                              SelectionChanged="ProductsGrid_SelectionChanged"
                                              MouseDoubleClick="ProductsGrid_MouseDoubleClick">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Добавить товар" Click="BtnAddProduct_Click" />
                                                <MenuItem Header="Редактировать товар" Click="BtnEditProduct_Click" />
                                                <MenuItem Header="Сменить изображение" Click="BtnEditProduct_Click" />
                                                <Separator />
                                                <MenuItem Header="Удалить товар" Click="BtnDeleteProduct_Click" />
                                                <MenuItem Header="Сформировать отчёт" Click="BtnProductReport_Click" />
                                                <Separator />
                                                <MenuItem Header="Обновить список" Click="BtnRefreshProducts_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="58">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Width="40" Height="30" CornerRadius="3"
                                                                Background="#161E1B" ClipToBounds="True">
                                                            <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Наименование" Width="*" Binding="{Binding Name}" />
                                            <DataGridTextColumn Header="Артикул" Width="110" Binding="{Binding Sku}" />
                                            <DataGridTextColumn Header="Цена, ₽" Width="110" Binding="{Binding PriceDisplay}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Обновить" Style="{StaticResource SmallButton}"
                                                Click="BtnRefreshProducts_Click" Margin="0,0,8,0"
                                                ToolTip="Перечитать каталог из базы данных" />
                                        <TextBlock Text="Двойной щелчок по строке открывает карточку товара."
                                                   Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Карточка товара" Style="{StaticResource CardTitle}" />

                                    <StackPanel Grid.Row="1">
                                        <Border Background="#182420" CornerRadius="6" Height="230" ClipToBounds="True"
                                                BorderBrush="{StaticResource BorderMuted}" BorderThickness="1">
                                            <Image x:Name="ProductDetailImage" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock x:Name="ProductDetailName" Text="Товар не выбран"
                                                   Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                   Margin="0,14,0,4" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ProductDetailSku" Text="—"
                                                   Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        <TextBlock x:Name="ProductDetailPrice" Text="—"
                                                   Foreground="{StaticResource Gold}" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,10,0,0" />
                                        <TextBlock x:Name="ProductDetailImagePath" Text="Изображение не задано"
                                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                        <Button Content="Открыть карточку" Style="{StaticResource PrimaryButton}"
                                                Click="BtnEditProduct_Click"
                                                ToolTip="Открыть окно редактирования товара и изображения" />
                                        <TextBlock Text="Изображения хранятся в папке images рядом с исполняемым файлом."
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="Reportsv" Visibility="{Binding IsChecked, ElementName=Reports, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Отчёты" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="HTML-отчёты с фирменным оформлением и возможностью печати"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>
                            <Button Content="Открыть папку отчётов" Width="180"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="BtnOpenReportsFolder_Click"
                                    ToolTip="Открыть каталог Reports рядом с исполняемым файлом" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8"
                                    Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Параметры отчёта" Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Дата отчёта" Style="{StaticResource FieldLabel}" />
                                    <DatePicker x:Name="ReportDatePicker" Height="38" Margin="0,0,0,16"
                                                ToolTip="Дата, которая будет указана в отчёте" />

                                    <TextBlock Text="Состав каталога товаров" Style="{StaticResource FieldLabel}" />
                                    <RadioButton x:Name="ReportAllProducts" Content="Все товары"
                                                 GroupName="ReportFilter" IsChecked="True" Margin="0,4,0,6"
                                                 ToolTip="Включить в отчёт все товары" />
                                    <RadioButton x:Name="ReportOnlyWithImages"
                                                 Content="Только товары с изображением"
                                                 GroupName="ReportFilter" Margin="0,0,0,16"
                                                 ToolTip="Включить только товары, для которых загружено изображение" />

                                    <Border Background="#1B2D26" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Как отправить на печать"
                                                       Foreground="{StaticResource Gold}" FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Отчёт откроется в браузере. Для печати используйте меню браузера или сочетание Ctrl+P."
                                                       Foreground="{StaticResource TextSoft}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Доступные отчёты" Style="{StaticResource CardTitle}" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ReportsItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#20372E" CornerRadius="7" Padding="14"
                                                            Margin="0,0,0,9" BorderBrush="#365A49"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Title}" Foreground="White"
                                                                           FontSize="14" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           FontSize="11" Margin="0,4,0,0"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Сформировать"
                                                                    Style="{StaticResource SmallButton}"
                                                                    Tag="{Binding Kind}"
                                                                    Click="BtnGenerateReport_Click"
                                                                    ToolTip="Сформировать HTML-отчёт и открыть его в браузере" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AdminPanelv" Visibility="{Binding IsChecked, ElementName=AdminPanel, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Администрирование" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Управление пользователями, ролями и доступом к разделам системы"
                                           Style="{StaticResource PageSubtitle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnAddUser" Content="+ Добавить пользователя" Width="190"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                        Click="BtnAddUser_Click"
                                        ToolTip="Открыть окно создания учётной записи" />
                                <Button x:Name="BtnEditUser" Content="Изменить" Width="95"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Click="BtnEditUser_Click"
                                        ToolTip="Открыть окно редактирования выбранного пользователя" />
                                <Button x:Name="BtnDeleteUser" Content="Удалить" Width="90"
                                        Style="{StaticResource DangerButton}"
                                        Click="BtnDeleteUser_Click"
                                        ToolTip="Удалить выбранного пользователя. Свою учётную запись удалить нельзя" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0.9*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource CardBg}" Margin="0,0,0,10"
                                    CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="Пользователи системы" Style="{StaticResource CardTitle}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="UsersCountText" Text="0 учётных записей"
                                                       Style="{StaticResource MutedText}" Margin="0,0,12,0" />
                                            <Button Content="Обновить" Style="{StaticResource SmallButton}"
                                                    Click="BtnRefreshUsers_Click"
                                                    ToolTip="Перечитать список пользователей из базы данных" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid Grid.Row="1" x:Name="UsersGrid"
                                              SelectionChanged="UsersGrid_SelectionChanged"
                                              MouseDoubleClick="UsersGrid_MouseDoubleClick">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Добавить пользователя" Click="BtnAddUser_Click" />
                                                <MenuItem Header="Редактировать пользователя" Click="BtnEditUser_Click" />
                                                <Separator />
                                                <MenuItem Header="Удалить пользователя" Click="BtnDeleteUser_Click" />
                                                <MenuItem Header="Обновить список" Click="BtnRefreshUsers_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Фамилия и имя" Width="*" Binding="{Binding FullName}" />
                                            <DataGridTextColumn Header="Логин" Width="160" Binding="{Binding Login}" />
                                            <DataGridTextColumn Header="Роль" Width="160" Binding="{Binding RoleDisplay}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource CardBg}" Margin="0,10,0,0"
                                    CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Роли и права доступа к разделам"
                                               Style="{StaticResource CardTitle}" />
                                    <DataGrid Grid.Row="1" x:Name="RightsGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Раздел системы" Width="*" Binding="{Binding SectionName}" />
                                            <DataGridTextColumn Header="Администратор" Width="170" Binding="{Binding AdminRight}" />
                                            <DataGridTextColumn Header="Руководитель" Width="170" Binding="{Binding DirectorRight}" />
                                            <DataGridTextColumn Header="Менеджер" Width="170" Binding="{Binding ManagerRight}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1C2427" BorderBrush="#33443D" BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Дата:" Foreground="{StaticResource TextMuted}" FontSize="11" />
                    <TextBlock x:Name="StatusDate" Text="—" Foreground="{StaticResource TextSoft}"
                               FontSize="11" Margin="5,0,0,0" />
                    <Rectangle Width="1" Height="12" Fill="#3A4A50" Margin="14,0" />
                    <TextBlock Text="Время:" Foreground="{StaticResource TextMuted}" FontSize="11" />
                    <TextBlock x:Name="StatusTime" Text="—" Foreground="{StaticResource TextSoft}"
                               FontSize="11" Margin="5,0,0,0" />
                    <Rectangle Width="1" Height="12" Fill="#3A4A50" Margin="14,0" />
                    <TextBlock Text="Пользователь:" Foreground="{StaticResource TextMuted}" FontSize="11" />
                    <TextBlock x:Name="StatusUser" Text="Не авторизован" Foreground="{StaticResource Gold}"
                               FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" />
                    <TextBlock x:Name="StatusRole" Text="" Foreground="{StaticResource TextMuted}"
                               FontSize="11" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="© ООО «РОСПИВ» | информационная система" 
                Foreground="{StaticResource TextMuted}" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
