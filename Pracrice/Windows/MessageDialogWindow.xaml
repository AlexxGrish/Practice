<Window x:Class="Pracrice.Windows.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение"
        Width="560"
        Height="290"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1C2427" Padding="24,16" BorderBrush="#33443D" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="Сообщение"
                           Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="ООО «РОСПИВ» | информационная система"
                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconCircle" Width="42" Height="42" CornerRadius="21"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Background="#2B5748">
                <TextBlock x:Name="IconGlyph" Text="i" Foreground="{StaticResource GoldLight}"
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          MaxHeight="190" VerticalAlignment="Center">
                <TextBlock x:Name="MessageText" Text=""
                           Foreground="{StaticResource TextMain}" FontSize="13"
                           TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#1C2427" Padding="24,12" BorderBrush="#33443D" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNo" Content="Нет" Width="100" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="BtnNo_Click" Visibility="Collapsed"
                        ToolTip="Отменить действие" />
                <Button x:Name="BtnYes" Content="Да" Width="110" Style="{StaticResource PrimaryButton}"
                        Click="BtnYes_Click" ToolTip="Подтвердить действие" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
