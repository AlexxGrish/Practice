<Window x:Class="Pracrice.Windows.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Width="820"
        Height="700"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1C2427" Padding="26,20" BorderBrush="#33443D" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="Карточка товара"
                           Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderSubtitle" Text="Наименование, артикул, цена и изображение"
                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8"
                        Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Изображение товара" Style="{StaticResource CardTitle}" />
                        <Border Background="#182420" CornerRadius="6" Height="270" ClipToBounds="True"
                                BorderBrush="{StaticResource BorderMuted}" BorderThickness="1">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="ImagePathText" Text="Изображение не задано"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Margin="0,10,0,12" />
                        <Button Content="Выбрать изображение..." Style="{StaticResource SecondaryButton}"
                                Click="BtnChooseImage_Click"
                                ToolTip="Выбрать файл PNG, JPG, BMP или GIF и скопировать его в папку images" />
                        <Button Content="Удалить изображение" Style="{StaticResource DangerButton}"
                                Margin="0,8,0,0" Click="BtnRemoveImage_Click"
                                ToolTip="Убрать изображение из карточки товара" />
                       
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8"
                        Padding="18" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Основные сведения" Style="{StaticResource CardTitle}" />

                        <TextBlock Text="Наименование *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Height="40" Margin="0,0,0,14"
                                 ToolTip="Наименование выпускаемой продукции, не более 150 символов" />

                        <TextBlock Text="Артикул (Уникальный) *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SkuBox" Height="40" Margin="0,0,0,14"
                                 ToolTip="Уникальный артикул товара, не более 50 символов" />

                        <TextBlock Text="Цена, ₽ *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PriceBox" Height="40" Margin="0,0,0,14"
                                 ToolTip="Отпускная цена за единицу товара. Например: 1250,00" />

                        <Border Background="#1B2D26" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Требования к изображению"
                                           Foreground="{StaticResource Gold}" FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Поддерживаются PNG, JPG, JPEG, BMP и GIF. Рекомендуется изображение не менее 640×420 точек."
                                           Foreground="{StaticResource TextSoft}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#1C2427" Padding="26,14" BorderBrush="#33443D" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="* — обязательные поля" Foreground="{StaticResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="110" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="BtnCancel_Click"
                            ToolTip="Закрыть окно без сохранения" />
                    <Button x:Name="BtnSave" Content="Сохранить" Width="140"
                            Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"
                            ToolTip="Проверить данные и сохранить товар" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
