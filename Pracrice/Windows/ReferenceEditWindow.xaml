<Window x:Class="Pracrice.Windows.ReferenceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись справочника"
        Width="680"
        Height="640"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1C2427" Padding="26,20" BorderBrush="#33443D" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="Запись справочника"
                           Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderSubtitle" Text=""
                           Foreground="{StaticResource TextMuted}" FontSize="12"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22"
                      VerticalContentAlignment="Top">
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="20"
                    VerticalAlignment="Top">
                <StackPanel x:Name="FieldsPanel" />
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#1C2427" Padding="26,14" BorderBrush="#33443D" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="* — обязательные поля" Foreground="{StaticResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="110" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="BtnCancel_Click"
                            ToolTip="Закрыть окно без сохранения" />
                    <Button x:Name="BtnSave" Content="Сохранить" Width="140"
                            Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"
                            ToolTip="Проверить данные и сохранить запись" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
