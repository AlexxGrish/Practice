<Window x:Class="Pracrice.Windows.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Width="580"
        Height="650"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1C2427" Padding="26,20" BorderBrush="#33443D" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="Учётная запись пользователя"
                           Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderSubtitle" Text="Логин, роль и пароль для входа в систему"
                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22">
            <StackPanel>
                <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LoginBox" Height="40" Margin="0,0,0,14"
                                 ToolTip="Уникальный логин для входа. Без пробелов, не более 50 символов" />

                        <TextBlock Text="Фамилия и имя *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FullNameBox" Height="40" Margin="0,0,0,14"
                                 ToolTip="Фамилия и имя владельца учётной записи, например «Иванов Иван»" />

                        <TextBlock Text="Роль *" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RoleCombo" Height="40" DisplayMemberPath="Title"
                                  SelectedValuePath="Value" Margin="0,0,0,6"
                                  SelectionChanged="RoleCombo_SelectionChanged"
                                  ToolTip="Роль определяет доступные разделы и права пользователя" />
                        <TextBlock x:Name="RoleDescription" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock x:Name="PasswordLabel" Text="Пароль *" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,14"
                                     ToolTip="Пароль не короче 6 символов. В базе данных хранится только хеш пароля" />

                        <TextBlock x:Name="PasswordConfirmLabel" Text="Повторите пароль *"
                                   Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordConfirmBox" Height="40"
                                     ToolTip="Повторите пароль для исключения опечатки" />

                        <TextBlock x:Name="PasswordHint" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#20372E" CornerRadius="6" Padding="14" Margin="0,14,0,0"
                        BorderBrush="#365A49" BorderThickness="1">
                    <TextBlock Text="Пароль хранится в базе данных в виде хеша BCrypt. Администратор не может посмотреть исходный пароль пользователя."
                               Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#1C2427" Padding="26,14" BorderBrush="#33443D" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="* — обязательные поля" Foreground="{StaticResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="110" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="BtnCancel_Click"
                            ToolTip="Закрыть окно без сохранения" />
                    <Button x:Name="BtnSave" Content="Сохранить" Width="140"
                            Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"
                            ToolTip="Проверить данные и сохранить учётную запись" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
